# ---- FanzPay environment ----
# Salin menjadi .env lalu isi. JANGAN commit .env berisi kredensial asli.
APP_NAME=FanzPay
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/fanzpay/web
APP_KEY=isi-dengan-string-acak-32-karakter

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fanzpay_web
DB_USER=root
DB_PASS=

MAIL_FROM=noreply@fanzpay.local
MAIL_FROM_NAME=FanzPay

# BuatQris (server-side only — jangan pernah ke frontend)
BUATQRIS_ACCOUNT_ID=
BUATQRIS_SECRET_TOKEN=
BUATQRIS_SIGNING_SECRET=
BUATQRIS_BASE_URL=https://api.buatqris.site
BUATQRIS_SANDBOX=true

# DigiFlazz (server-side only)
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=
DIGIFLAZZ_BASE_URL=https://api.digiflazz.com/v1
DIGIFLAZZ_SANDBOX=true

# Super admin pertama (dibaca install.php; kosongkan setelah akun dibuat)
SUPERADMIN_NAME=
SUPERADMIN_EMAIL=
SUPERADMIN_PHONE=
SUPERADMIN_PASSWORD=
